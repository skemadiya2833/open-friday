# Single streaming VLM (Qwen2.5-VL)
MODEL=qwen2.5vl:7b-q4_K_M
MODEL_KEEP_ALIVE=-1

# Live mode (continuous feed — not discrete screenshot capture)
LIVE_MODE=true
LIVE_PREVIEW_FPS=4

# Use 1 frame per inference tick (most reliable with qwen2.5vl).
STREAM_USE_VIDEO=false
STREAM_FRAME_COUNT=1
STREAM_TICK_SECONDS=0.5

CONTEXT_SUMMARIZE_EVERY=8
CONTEXT_RECENT_ACTIONS=5

HIDE_UI_FROM_CAPTURE=true
CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

MAX_ITERATIONS=30
OVERLAY_ENABLED=true
CLICK_MARKER_ENABLED=true

# Aim → verify (live stream) → adjust → click
AIM_VERIFY_ENABLED=true
AIM_VERIFY_MAX_ROUNDS=3
AIM_VERIFY_SETTLE_MS=450

NPU_PREPROCESSING=true
