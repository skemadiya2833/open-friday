# Vision + chat (unified qwen3.5:9b avoids load/unload thrash on 16GB)
MODEL=qwen3.5:9b
VISION_MODEL=qwen3.5:9b
CHAT_MODEL=qwen3.5:9b
# CPU embeddings for vector memory (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
MODEL_KEEP_ALIVE=-1
MODEL_NUM_PREDICT=1024
# Fast chat (VL is heavy for dialogue)
CHAT_NUM_PREDICT=256
CHAT_NUM_CTX=4096
# Keyword skill routing (set true for embedding-based routing — slower)
SKILL_EMBED_ROUTE=false
# RAG on every chat turn (slower; memory skill still works)
CHAT_RAG_ENABLED=false
INDEX_CHAT_TURNS=false
MODEL_TEMPERATURE=0.2
MODEL_COORD_SPACE=pixel
MODEL_THINK=false

LIVE_MODE=true
LIVE_PREVIEW_FPS=2
STREAM_USE_VIDEO=false
STREAM_FRAME_COUNT=1
STREAM_TICK_SECONDS=0.5
POST_ACTION_SETTLE_SECONDS=0.8

CONTEXT_SUMMARIZE_EVERY=8
CONTEXT_RECENT_ACTIONS=5
HIDE_UI_FROM_CAPTURE=true

CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_if_using_openai

MAX_ITERATIONS=60
MAX_EMPTY_DECISIONS=4
MAX_KNOWLEDGE_SEARCHES=3
MAX_TOOL_STEPS=8
OVERLAY_ENABLED=true
CLICK_MARKER_ENABLED=true
AIM_VERIFY_ENABLED=true
AIM_VERIFY_MAX_ROUNDS=2
AIM_VERIFY_SETTLE_MS=350

REQUIRE_FRESH_FRAME=true
ALLOW_PROSE_SYNTHESIS=false
REQUIRE_COMPLETION_EVIDENCE=true

# Control Center — loopback until passkeys + public hostname are ready (docs/PHONE_SETUP.md)
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8787
FRIDAY_TLS_PORT=8788
# Auth: off | local (PC passkeys, loopback) | remote (needs FRIDAY_PUBLIC_HOST)
FRIDAY_AUTH=local
# FRIDAY_PUBLIC_HOST=friday.devoids.in
# FRIDAY_ORIGIN=https://friday.devoids.in
# Optional script bearer (not a substitute for device passkeys)
# FRIDAY_API_TOKEN=
VOICE_ENABLED=true
VOICE_STT_MODEL=large-v3-turbo   # provisional default (CUDA float16); accuracy on your voice UNVERIFIED
# Calm Irish-leaning neural voice (edge-tts). Alt: en-GB-SoniaNeural
VOICE_TTS_VOICE=en-IE-EmilyNeural
# Keep false unless you accept shell tools (still need UI approval per call)
SHELL_TOOLS_ENABLED=false

# Persona (docs/PERSONA.md)
FRIDAY_OWNER_NAME=boss
FRIDAY_HUMOR=dry
# FRIDAY_DEEP=false
# FRIDAY_DEEP_TOKEN_BUDGET=512
# FRIDAY_DEEP_TIMEOUT=45

# Optional role map (defaults stay qwen3.5:9b until you opt in)
# FRIDAY_MODEL_ROLES=false
# FRIDAY_MODEL_FAST=qwen3.5:4b
# FRIDAY_MODEL_MAIN=qwen3.5:9b
# FRIDAY_MODEL_VISION=qwen3.5:9b
# FRIDAY_MODEL_CODER=qwen3-coder:30b

# LOW_END_MODE=true
