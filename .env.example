LOCAL_MODEL=minicpm-v
CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_if_using_openai

# Execution loop limits
MAX_ITERATIONS=30
MAX_STEPS_PER_BATCH=8

# Overlay (set to false to disable the floating progress window)
OVERLAY_ENABLED=true
USE_OVERLAY_APPROVAL=true

# NPU image preprocessing (falls back to Pillow when NPU unavailable)
NPU_PREPROCESSING=true
# Max width/height bounding box for the VLM image (aspect ratio preserved)
PREPROCESS_WIDTH=1120
PREPROCESS_HEIGHT=1120