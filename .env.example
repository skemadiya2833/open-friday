# Vision + chat (unified qwen3.5:9b avoids load/unload thrash on 16GB)
MODEL=qwen3.5:9b
VISION_MODEL=qwen3.5:9b
CHAT_MODEL=qwen3.5:9b
# CPU embeddings for vector memory (ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
MODEL_KEEP_ALIVE=-1
MODEL_NUM_PREDICT=1024
# Fast chat (VL is heavy for dialogue)
CHAT_NUM_PREDICT=256
CHAT_NUM_CTX=4096
# Keyword skill routing (set true for embedding-based routing — slower)
SKILL_EMBED_ROUTE=false
# RAG on every chat turn (slower; memory skill still works)
CHAT_RAG_ENABLED=false
INDEX_CHAT_TURNS=false
MODEL_TEMPERATURE=0.2
MODEL_COORD_SPACE=pixel
MODEL_THINK=false

LIVE_MODE=true
LIVE_PREVIEW_FPS=2
STREAM_USE_VIDEO=false
STREAM_FRAME_COUNT=1
STREAM_TICK_SECONDS=0.5
POST_ACTION_SETTLE_SECONDS=0.8

CONTEXT_SUMMARIZE_EVERY=8
CONTEXT_RECENT_ACTIONS=5
HIDE_UI_FROM_CAPTURE=true

CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_if_using_openai

MAX_ITERATIONS=60
MAX_EMPTY_DECISIONS=4
MAX_KNOWLEDGE_SEARCHES=3
MAX_TOOL_STEPS=8
OVERLAY_ENABLED=true
CLICK_MARKER_ENABLED=true
AIM_VERIFY_ENABLED=true
AIM_VERIFY_MAX_ROUNDS=2
AIM_VERIFY_SETTLE_MS=350

REQUIRE_FRESH_FRAME=true
ALLOW_PROSE_SYNTHESIS=false
REQUIRE_COMPLETION_EVIDENCE=true

# Control Center — see docs/PHONE_SETUP.md
# Everyday knobs (humor, agent backend, voice, shell tools, …) live in Systems → Preferences.
# Only host/auth/API keys and paths need .env. Optima are applied when a pref is unset.
# FRIDAY_UI=public          # public (vanilla web/public, default) | dist (Vite build)
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8787
FRIDAY_TLS_PORT=8788
# Auth: off | local (this PC) | lan (phone on Wi‑Fi, approve then optional passkey) | remote (passkeys + public host)
FRIDAY_AUTH=local
# Phone on same Wi‑Fi (simplest):
# FRIDAY_AUTH=lan
# FRIDAY_HOST=0.0.0.0
# FRIDAY_REQUIRE_PHYSICAL_INPUT=false
# FRIDAY_PUBLIC_HOST=friday.devoids.in
# FRIDAY_ORIGIN=https://friday.devoids.in
# Optional script bearer (not a substitute for device passkeys)
# FRIDAY_API_TOKEN=
# Content security (OpenJarvis-adapted): warn | redact | block
FRIDAY_SECRETS_MODE=redact
FRIDAY_INJECTION_MODE=warn
# SSRF on research fetches is always block (no env override for allow-private).

VOICE_ENABLED=true
VOICE_STT_MODEL=large-v3-turbo   # provisional default (CUDA float16); accuracy on your voice UNVERIFIED
# Natural conversational neural voice (edge-tts). Alts: en-US-JennyNeural, en-US-AriaNeural, en-GB-SoniaNeural
VOICE_TTS_VOICE=en-US-AvaNeural
# Keep false unless you accept shell tools (still need UI approval per call)
SHELL_TOOLS_ENABLED=false

# Persona / agent / safety — prefer Systems → Preferences (data/runtime_prefs.json).
# Uncomment only to force via env before first UI visit:
# FRIDAY_OWNER_NAME=boss
# FRIDAY_HUMOR=dry
# AGENT_BACKEND=            # auto | legacy | hybrid
# FRIDAY_DEEP=false
# FRIDAY_MODEL_ROLES=false
# FRIDAY_MODEL_FAST=qwen3.5:4b
# FRIDAY_MODEL_MAIN=qwen3.5:9b
# FRIDAY_MODEL_VISION=qwen3.5:9b
# FRIDAY_MODEL_CODER=qwen3-coder:30b
# Heuristic complexity routing: simple → 4b, hard → 9b (opt-in; default stays 9b)
# FRIDAY_COMPLEXITY_ROUTING=false

# Morning briefing (owner Settings toggle; built-in cron, not agent-schedulable)
# FRIDAY_MORNING_BRIEFING=false

# Desk webcam (off by default). Needs: pip install -r requirements/camera.lock.txt
# Then Arm camera in Systems before asking "what am I looking at?"
# FRIDAY_CAMERA=off
# FRIDAY_CAMERA_INDEX=0
# Prefer Systems → Camera device picker; it writes data/camera_prefs.json over this default.
# FRIDAY_CAMERA_ARM_TTL=300

# LOW_END_MODE=true
