# Single local vision model (Ollama)
MODEL=qwen2.5vl:7b-q4_K_M
MODEL_KEEP_ALIVE=-1
# Cap per-tick output; decisions are short. Raise only if responses truncate.
MODEL_NUM_PREDICT=1024
# Low temperature keeps the action JSON deterministic.
MODEL_TEMPERATURE=0.2
# MODEL_TOP_P=0.9
# MODEL_NUM_CTX=8192
# qwen2.5vl grounds in absolute pixels of the resized image
MODEL_COORD_SPACE=pixel
MODEL_THINK=false

# Low-end / weak hardware profile (or pass: python main.py --low-end)
# LOW_END_MODE=true
# When enabled, defaults to: 896px frames, JPEG encode, bilinear resize,
# 1 fps preview, aim-verify off, smaller model output cap.
# Override any single setting below even with LOW_END_MODE=true.

# Live vision feed
LIVE_MODE=true
LIVE_PREVIEW_FPS=2
# GUI_LIVE_EMIT_INTERVAL=0
# PREPROCESS_WIDTH=1120
# PREPROCESS_HEIGHT=1120
# PREPROCESS_FORMAT=png
# PREPROCESS_RESAMPLE=lanczos

# Prefer a single frame per tick — fastest and most reliable.
STREAM_USE_VIDEO=false
STREAM_FRAME_COUNT=1
STREAM_TICK_SECONDS=0.5
POST_ACTION_SETTLE_SECONDS=0.8

CONTEXT_SUMMARIZE_EVERY=8
CONTEXT_RECENT_ACTIONS=5

CLOUD_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_key_if_using_openai

MAX_ITERATIONS=60
MAX_EMPTY_DECISIONS=4
MAX_KNOWLEDGE_SEARCHES=3
OVERLAY_ENABLED=true
CLICK_MARKER_ENABLED=true

# Production hardening
REQUIRE_FRESH_FRAME=true
ALLOW_PROSE_SYNTHESIS=false
REQUIRE_COMPLETION_EVIDENCE=true
HIDE_UI_FROM_CAPTURE=true

# Aim → verify (live stream) → adjust → click
AIM_VERIFY_ENABLED=true
AIM_VERIFY_MAX_ROUNDS=2
AIM_VERIFY_SETTLE_MS=350
